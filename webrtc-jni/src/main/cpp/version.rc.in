// Windows VERSIONINFO for the WebRTC JNI library.
//
// AppLocker and WDAC publisher rules key on this resource, not on the Authenticode signature alone:
// without ProductName / OriginalFilename / FileVersion an administrator can only write a hash rule,
// which breaks on every release. Signing does not add the resource - it has to be compiled in.
//
// Configured by CMake from version.rc.in; the version comes from the Gradle project version, passed
// to CMake as -DWEBRTC_JAVA_VERSION by webrtc-jni/build.gradle.kts.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @WEBRTC_JAVA_VERSION_COMMA@
PRODUCTVERSION  @WEBRTC_JAVA_VERSION_COMMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Saga IT, LLC"
            VALUE "FileDescription",  "OpenShare WebRTC Native (data channels)"
            VALUE "FileVersion",      "@WEBRTC_JAVA_VERSION@"
            VALUE "InternalName",     "webrtc-java"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Saga IT, LLC. Apache License, Version 2.0."
            VALUE "OriginalFilename", "@WEBRTC_JAVA_DLL_NAME@"
            VALUE "ProductName",      "OpenShare WebRTC Native"
            VALUE "ProductVersion",   "@WEBRTC_JAVA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
